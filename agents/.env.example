# COVENANT Agent Environment Variables

# Wallet keys (required for on-chain operations)
CLIENT_PRIVATE_KEY=0x...
WORKER_PRIVATE_KEY=0x...

# AI model API (for verification)
ANTHROPIC_API_KEY=sk-...

# IPFS (for uploading deliverables)
PINATA_API_KEY=...
PINATA_SECRET_KEY=...

# RPC (optional, defaults to Base Sepolia)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Contract addresses (auto-detected from ABI, but can override)
COVENANT_IDENTITY_ADDRESS=0xFa1bFd34290bf12A2F09Ea24Cda05E71cc79c1fF
COVENANT_ESCROW_ADDRESS=0x130e2027eB57C427Bf63E2B06d35B10CB20C4b77
COVENANT_SETTLEMENT_ADDRESS=0x61124E9aDAd3167ED1DB644a901a5838c8725251
