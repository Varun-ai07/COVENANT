# Network
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer wallet (deploys contracts)
PRIVATE_KEY=your_deployer_private_key

# Client agent wallet (needs 0.004 ETH)
CLIENT_PRIVATE_KEY=your_client_private_key

# Worker agent wallet (needs 0.003 ETH)
WORKER_PRIVATE_KEY=your_worker_private_key

# Contract addresses (auto-filled after deployment)
REGISTRY_ADDRESS=
ESCROW_ADDRESS=
VERIFIER_ADDRESS=

# OpenRouter API Key (free tier available!)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Autonomous dispute resolver (must be TaskEscrow owner wallet)
DISPUTE_RESOLVER_PRIVATE_KEY=
# Optional polling interval for dispute resolver agent
DISPUTE_POLL_INTERVAL_MS=15000

# Optional: Choose AI model (default: free Llama 3.1 8B)
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet (paid)

# IPFS — optional, leave blank to skip
PINATA_API_KEY=
PINATA_SECRET_KEY=

# Demo settings (testnet optimized)
AGENT_STAKE=0.001
TASK_PAYMENT=0.001
