{
  "name": "@covenant/sdk",
  "version": "2.0.0",
  "description": "TypeScript SDK for COVENANT - Autonomous Agent Enforcement Protocol",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2.mjs",
      "require": "./dist/v2.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/v2.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/v2.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "covenant",
    "agent",
    "blockchain",
    "base",
    "autonomous",
    "escrow",
    "web3"
  ],
  "author": "COVENANT Protocol",
  "license": "MIT",
  "peerDependencies": {
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "viem": "^2.0.0"
  },
  "dependencies": {
    "@covenant/shared-types": "*",
    "@lit-protocol/auth-helpers": "^8.2.1",
    "@lit-protocol/constants": "^9.0.1",
    "@lit-protocol/encryption": "^7.4.0",
    "@lit-protocol/types": "^8.0.4"
  }
}
