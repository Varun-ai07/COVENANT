// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import "@openzeppelin/contracts/access/Ownable.sol";

// Interface for ZK Capability Verifier (must be outside contract)
interface ICapabilityVerifier {
    function verifyProof(
        uint[2] calldata _pA,
        uint[2][2] calldata _pB,
        uint[2] calldata _pC,
        uint[5] calldata _pubSignals
    ) external view returns (bool);
}

// Interface for ZK Reputation Verifier (must be outside contract)
interface IReputationVerifier {
    function verifyProof(
        uint[2] calldata _pA,
        uint[2][2] calldata _pB,
        uint[2] calldata _pC,
        uint[4] calldata _pubSignals
    ) external view returns (bool);
}

contract AgentRegistry is Ownable {

    // Events
    event AgentRegistered(address indexed agent, bytes32 indexed did, string name, uint256 stake);
    event ReputationUpdated(address indexed agent, int256 delta, uint256 newReputation);
    event AgentDeactivated(address indexed agent);
    event AuthorizedContractAdded(address indexed contractAddr);
    event AuthorizedContractRemoved(address indexed contractAddr);
    event ZKCapabilityRegistered(address indexed agent, string indexed capabilityId, bytes32 commitment);
    event NullifierUsed(bytes32 indexed nullifier);
    event ZKReputationRegistered(address indexed agent, uint256 minReputation, uint256 maxReputation, bytes32 commitment);
    event ZKReputationVerified(address indexed agent, uint256 minReputation, uint256 maxReputation, bool proofValid);

    // ============ OPTIMIZED AGENT STRUCT (~5 storage slots) ============
    // Slot 0: did (256 bits) - must be alone
    // Slot 1: isActive(8) + reputation(16) + tasksFailed(16) + tasksCompleted(32) + stakedAmount(96) = 168 bits (88 free)
    // Slot 2: registeredAt(48) + lastTaskAt(48) + totalValueTransferred(96) = 192 bits (64 free)
    // Slot 3+: name (dynamic string)
    // Slot N: capabilities (dynamic array)
    struct Agent {
        bytes32 did;                    // 256 bits - slot 0
        uint8 isActive;                //   8 bits - slot 1
        uint16 reputation;             //  16 bits - slot 1
        uint16 tasksFailed;            //  16 bits - slot 1
        uint32 tasksCompleted;         //  32 bits - slot 1
        uint96 stakedAmount;           //  96 bits - slot 1
        uint48 registeredAt;           //  48 bits - slot 2
        uint48 lastTaskAt;             //  48 bits - slot 2
        uint96 totalValueTransferred;  //  96 bits - slot 2
        string name;                   // dynamic - slot 3+
        string[] capabilities;         // dynamic - slot N
    }
    // =====================================================================

    // Minimum stake required for registration (0.001 ETH)
    uint256 public constant MIN_STAKE = 0.001 ether;

    // Initial reputation for new agents
    uint16 public constant INITIAL_REPUTATION = 500;

    // Max reputation cap
    uint16 public constant MAX_REPUTATION = 1000;

    // Storage
    mapping(address => Agent) public agents;
    mapping(string => address[]) public capabilityToAgents;
    address[] public registeredAgents;

    // Authorized contracts that can update reputation (e.g., TaskEscrow)
    mapping(address => bool) public authorizedContracts;

    // ZK Capability Verifier
    address public capabilityVerifier;

    // ZK Reputation Verifier
    address public reputationVerifier;

    // Commitment storage: capabilityId => (agent => commitment)
    mapping(string capabilityId => mapping(address agent => bytes32)) public zkCapabilityCommitments;

    // Reputation commitment storage: agent => (min => max => commitment)
    mapping(address => mapping(uint256 => mapping(uint256 => bytes32))) public zkReputationCommitments;

    // Nullifier tracking for replay protection    mapping(bytes32 nullifier => bool) public usedNullifiers;

    // Error definitions for gas optimization
    error AgentAlreadyRegistered();
    error InsufficientStake(uint256 provided, uint256 required);
    error AgentNotRegistered(address agent);
    error AgentNotActive(address agent);
    error InvalidCapabilities();
    error NotAuthorized();
    error ZKVerifierNotSet();
    error ZKProofFailed();
    error CommitmentMismatch(string capabilityId, bytes32 expected, bytes32 actual);
    error NullifierAlreadyUsed();
    error ZKCapabilityAlreadyRegistered();
    error ZKReputationVerifierNotSet();
    error ZKReputationAlreadyRegistered();
    error InvalidReputationRange();
    error ZKReputationProofFailed();

    constructor() Ownable(msg.sender) {}

    modifier onlyAuthorized() {
        if (!authorizedContracts[msg.sender] && msg.sender != owner()) {
            revert NotAuthorized();
        }
        _;
    }

    /**
     * @notice Register as an agent in the COVENANT network
     * @param name Human-readable agent name
     * @param capabilities Array of capability strings
     */
    function register(
        string calldata name,
        string[] calldata capabilities
    ) external payable {
        if (bytes(name).length == 0) {
            revert InvalidCapabilities(); // Reusing for empty name
        }
        if (agents[msg.sender].isActive != 0) {
            revert AgentAlreadyRegistered();
        }
        if (msg.value < MIN_STAKE) {
            revert InsufficientStake(msg.value, MIN_STAKE);
        }
        if (capabilities.length == 0) {
            revert InvalidCapabilities();
        }

        // Generate DID from address + timestamp
        bytes32 did = keccak256(
            abi.encodePacked(msg.sender, block.timestamp, block.chainid)
        );

        // Store agent
        agents[msg.sender] = Agent({
            did: did,
            name: name,
            capabilities: capabilities,
            reputation: INITIAL_REPUTATION,
            stakedAmount: uint96(msg.value),
            tasksCompleted: 0,
            tasksFailed: 0,
            totalValueTransferred: 0,
            isActive: 1,
            registeredAt: uint48(block.timestamp),
            lastTaskAt: 0
        });

        // Index by capability for discovery
        for (uint256 i = 0; i < capabilities.length; i++) {
            capabilityToAgents[capabilities[i]].push(msg.sender);
        }

        registeredAgents.push(msg.sender);

        emit AgentRegistered(msg.sender, did, name, msg.value);
    }

    /**
     * @notice Add additional stake to existing registration     */
    function addStake() external payable {
        if (agents[msg.sender].isActive == 0) {
            revert AgentNotActive(msg.sender);
        }
        if (msg.value == 0) {
            revert InsufficientStake(msg.value, 1); // Using 1 wei as minimum > 0
        }

        unchecked {
            agents[msg.sender].stakedAmount += uint96(msg.value);
        }
    }

    /**
     * @notice Discover agents by capability
     * @param capability The capability to search for     * @return agentAddresses Array of agent addresses with the capability
     */
    function getAgentsByCapability(
        string calldata capability
    ) external view returns (address[] memory) {
        address[] memory allAgents = capabilityToAgents[capability];

        // Filter to only active agents
        uint256 activeCount = 0;
        for (uint256 i = 0; i < allAgents.length; i++) {
            if (agents[allAgents[i]].isActive != 0) {
                activeCount++;
            }
        }

        address[] memory activeAgents = new address[](activeCount);
        uint256 idx = 0;
        for (uint256 i = 0; i < allAgents.length; i++) {
            if (agents[allAgents[i]].isActive != 0) {
                activeAgents[idx] = allAgents[i];
                idx++;
            }
        }

        return activeAgents;
    }


    /**
     * @notice Record task completion
     */
    function recordTaskCompletion(
        address agent,
        bool success,
        uint256 valueTransferred
    ) external onlyAuthorized {
        if (agents[agent].isActive == 0) {
            revert AgentNotActive(agent);
        }

        if (success) {
            unchecked {
                agents[agent].tasksCompleted++;
            }
        } else {
            unchecked {
                agents[agent].tasksFailed++;
            }
        }

        agents[agent].totalValueTransferred += uint96(valueTransferred);
    }

    /**
     * @notice Deactivate an agent (returns stake minus any pending obligations)
     */
    function deactivate() external {
        if (agents[msg.sender].isActive == 0) {
            revert AgentNotActive(msg.sender);
        }

        agents[msg.sender].isActive = 0;

        uint96 stakeToReturn = agents[msg.sender].stakedAmount;
        agents[msg.sender].stakedAmount = 0;

        if (stakeToReturn > 0) {
            (bool sent, ) = payable(msg.sender).call{value: stakeToReturn}("");
            require(sent, "Failed to send stake");
        }

        emit AgentDeactivated(msg.sender);
    }

    /**
     * @notice Get full agent profile
     */
    function getAgent(
        address agentAddr
    ) external view returns (Agent memory) {
        return agents[agentAddr];
    }

    /**
     * @notice Get total number of registered agents
     */
    function getAgentCount() external view returns (uint256) {
    function updateReputation(address agent, bool success) external {
        require(msg.sender == reputationVerifier, "Not authorized");
        if (success) {
            agents[agent].reputation += 15;
        } else {
            agents[agent].reputation = agents[agent].reputation >= 15 ? agents[agent].reputation - 15 : 0;
        }
    }
        return registeredAgents.length;
    }

    /**
     * @notice Get all registered agent addresses
     */
    function getAllAgents() external view returns (address[] memory) {
        return registeredAgents;
    }

    /**
     * @notice Register a ZK capability commitment for this agent     * @param capabilityId The capability identifier (e.g., "image-generation")
     * @param registeredCommitment The commitment computed from private inputs
     */
    function registerCapabilityZK(
        string calldata capabilityId,
        bytes32 registeredCommitment
    ) external {
        if (agents[msg.sender].isActive == 0) {
            revert AgentNotActive(msg.sender);
        }
        if (bytes(capabilityId).length == 0) {
            revert InvalidCapabilities();
        }
        bytes32 existing = zkCapabilityCommitments[capabilityId][msg.sender];
        if (existing != 0) {
            revert ZKCapabilityAlreadyRegistered();
        }

        // Store commitment
        zkCapabilityCommitments[capabilityId][msg.sender] = registeredCommitment;

        // Add to capability discovery mapping (unified with plaintext)
        capabilityToAgents[capabilityId].push(msg.sender);

        emit ZKCapabilityRegistered(msg.sender, capabilityId, registeredCommitment);
    }

    /**
     * @notice Register a ZK reputation commitment for this agent
     * @dev Allows agents to prove their reputation falls within a range without revealing the exact number
     * @param minReputation Minimum reputation in the range (inclusive)
     * @param maxReputation Maximum reputation in the range (inclusive)
     * @param registeredCommitment The commitment computed from private inputs (reputation value)
     */
    function registerReputationZK(
        uint256 minReputation,
        uint256 maxReputation,
        bytes32 registeredCommitment
    ) external {
        if (agents[msg.sender].isActive == 0) {
            revert AgentNotActive(msg.sender);
        }
        if (minReputation > maxReputation) {
            revert InvalidReputationRange();
        }
        if (maxReputation > MAX_REPUTATION) {
            revert InvalidReputationRange();
        }
        bytes32 existing = zkReputationCommitments[msg.sender][minReputation][maxReputation];
        if (existing != 0) {
            revert ZKReputationAlreadyRegistered();
        }

        // Store commitment
        zkReputationCommitments[msg.sender][minReputation][maxReputation] = registeredCommitment;

        emit ZKReputationRegistered(msg.sender, minReputation, maxReputation, registeredCommitment);
    }

    /**
     * @notice Verify a ZK capability proof
     * @param agent The agent address to verify
     * @param capabilityId The claimed capability string
     * @param zkProof ABI-encoded proof: (uint256[2] pA, uint256[2][2] pB, uint256[2] pC, uint256[5] pubSignals)
     * @return isValid Whether the proof is valid
     * @return nullifier The nullifier output from the proof (to be marked used separately)
     */
    function verifyCapabilityProof(
        address agent,
        string calldata capabilityId,
        bytes calldata zkProof
    ) external view returns (bool isValid, bytes32 nullifier) {
        if (capabilityVerifier == address(0)) revert ZKVerifierNotSet();

        // Decode the proof components using ABI encoding
        (uint256[2] memory pA, uint256[2][2] memory pB, uint256[2] memory pC, uint256[5] memory pubSignals) =
            abi.decode(zkProof, (uint256[2], uint256[2][2], uint256[2], uint256[5]));

        bytes32 storedCommitment = zkCapabilityCommitments[capabilityId][agent];
        require(storedCommitment != 0, "No commitment registered");

        // Validate public inputs: [capabilityIdHash, agentAddress, registeredCommitment, commitment, nullifier]
        require(pubSignals[0] == uint256(keccak256(bytes(capabilityId))), "CapabilityId mismatch");
        require(pubSignals[1] == uint256(uint160(agent)), "Agent mismatch");
        require(pubSignals[2] == uint256(storedCommitment), "Registered commitment mismatch");

        // Verify the ZK proof via external verifier
        bool proofValid = ICapabilityVerifier(capabilityVerifier).verifyProof(pA, pB, pC, pubSignals);
        require(proofValid, "Invalid ZK proof");

        // Extract nullifier (output index 4)
        nullifier = bytes32(pubSignals[4]);
        return (true, nullifier);
    }

    /**
     * @notice Verify a ZK reputation proof
     * @dev Allows agents to prove their reputation falls within a range without revealing the exact number
     * @param agent The agent address to verify     * @param minReputation Minimum reputation in the range (inclusive)
     * @param maxReputation Maximum reputation in the range (inclusive)
     * @param zkProof ABI-encoded proof: (uint256[2] pA, uint256[2][2] pB, uint256[2] pC, uint256[4] pubSignals)
     * @return isValid Whether the proof is valid     * @return nullifier The nullifier output from the proof (to be marked used separately)
     */
    function verifyReputationZK(
        address agent,
        uint256 minReputation,
        uint256 maxReputation,
        bytes calldata zkProof
    ) external view returns (bool isValid, bytes32 nullifier) {
        if (reputationVerifier == address(0)) revert ZKReputationVerifierNotSet();
        if (minReputation > maxReputation) revert InvalidReputationRange();
        if (maxReputation > MAX_REPUTATION) revert InvalidReputationRange();

        // Decode the proof components using ABI encoding
        (uint256[2] memory pA, uint256[2][2] memory pB, uint256[2] memory pC, uint256[4] memory pubSignals) =
            abi.decode(zkProof, (uint256[2], uint256[2][2], uint256[2], uint256[4]));

        bytes32 storedCommitment = zkReputationCommitments[agent][minReputation][maxReputation];
        require(storedCommitment != 0, "No reputation commitment registered");

        // Validate public inputs: [minReputation, maxReputation, agentAddress, commitment, nullifier]
        require(pubSignals[0] == minReputation, "Min reputation mismatch");
        require(pubSignals[1] == maxReputation, "Max reputation mismatch");
        require(pubSignals[2] == uint256(uint160(agent)), "Agent mismatch");
        require(pubSignals[3] == uint256(storedCommitment), "Commitment mismatch");

        // Verify the ZK proof via external verifier
        bool proofValid = IReputationVerifier(reputationVerifier).verifyProof(pA, pB, pC, pubSignals);
        
        // Emit event for verification result
        emit ZKReputationVerified(agent, minReputation, maxReputation, proofValid);
        
        if (!proofValid) {
            revert ZKReputationProofFailed();
        }

        // Extract nullifier (output index 3 for 4-element pubSignals)
        nullifier = bytes32(pubSignals[3]);
        return (true, nullifier);
    }

    /**
     * @notice Mark a nullifier as used (prevent replay)
     */
    function useNullifier(bytes32 nullifier) external {
        emit NullifierUsed(nullifier);
    }

    /**
     * @notice Get the stored ZK capability commitment for an agent
     */
    function getZKCapabilityCommitment(
        address agent,
        string calldata capabilityId
    ) external view returns (bytes32) {
        return zkCapabilityCommitments[capabilityId][agent];
    }

    /**
     * @notice Get the stored ZK reputation commitment for an agent
     */
    function getZKReputationCommitment(
        address agent,
        uint256 minReputation,
        uint256 maxReputation
    ) external view returns (bytes32) {
        return zkReputationCommitments[agent][minReputation][maxReputation];
    }

    /**
     * @notice Get all agents with a specific ZK capability
     */
    function getZKAgentsByCapability(
        string calldata capabilityId    ) external view returns (address[] memory) {
        // For simplicity, we iterate over all registeredAgents and filter.
        // In production, maintain a separate mapping similar to capabilityToAgents.
        address[] memory all = registeredAgents;
        address[] memory result = new address[](all.length);
        uint256 count = 0;
        for (uint256 i = 0; i < all.length; i++) {
            if (zkCapabilityCommitments[capabilityId][all[i]] != 0) {
                result[count] = all[i];
                count++;
            }
        }
        // Return array with exact size (cannot shrink in solidity; caller sees full length)
        // This is acceptable for now.
        return result;
    }

    /**
     * @notice Get all agents with reputation in a specific range (using ZK proofs)
     * @dev Returns agents who have registered a ZK commitment for the given range
     * This doesn't verify the proof - it just returns agents who have made the commitment
     *       To actually verify, callers should use verifyReputationZK
     */
    function getZKAgentsByReputationRange(
        uint256 minReputation,
        uint256 maxReputation    ) external view returns (address[] memory) {
        if (minReputation > maxReputation) revert InvalidReputationRange();
        if (maxReputation > MAX_REPUTATION) revert InvalidReputationRange();

        address[] memory all = registeredAgents;
        address[] memory result = new address[](all.length);
        uint256 count = 0;
        for (uint256 i = 0; i < all.length; i++) {
            if (zkReputationCommitments[all[i]][minReputation][maxReputation] != 0) {
                result[count] = all[i];
                count++;
            }
        }
        return result;
    }

    /**
     * @notice Add an authorized contract (owner only)
     */
    function addAuthorizedContract(address contractAddr) external onlyOwner {
        authorizedContracts[contractAddr] = true;
        emit AuthorizedContractAdded(contractAddr);
    }

    /**
     * @notice Remove an authorized contract (owner only)
     */
    function removeAuthorizedContract(address contractAddr) external onlyOwner {
        authorizedContracts[contractAddr] = false;
        emit AuthorizedContractRemoved(contractAddr);
    }

    /**
     * @notice Set the CapabilityVerifier contract address (owner only)
     */
    function setCapabilityVerifier(address _capabilityVerifier) external onlyOwner {
        require(_capabilityVerifier != address(0), "Invalid address");
        capabilityVerifier = _capabilityVerifier;
    }

    /**
     * @notice Set the ReputationVerifier contract address (owner only)
     */
    function setReputationVerifier(address _reputationVerifier) external onlyOwner {
        require(_reputationVerifier != address(0), "Invalid address");
        reputationVerifier = _reputationVerifier;
    }

    /**
     * @notice Slash an agent's stake (for severe violations)
     */
    function slashStake(
        address agent,
        uint256 slashAmount    ) external onlyAuthorized {
        if (agents[agent].isActive == 0) {
            revert AgentNotActive(agent);
        }
        require(slashAmount <= agents[agent].stakedAmount, "Slash exceeds stake");

        agents[agent].stakedAmount -= uint96(slashAmount);

        // Slashed funds go to the contract owner (protocol treasury)
        if (slashAmount > 0) {
            (bool sent, ) = owner().call{value: slashAmount}("");
            require(sent, "Failed to send slashed funds");
        }
    }
}