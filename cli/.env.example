# COVENANT CLI Configuration
# Copy this file to .env and fill in your values

# Required: Your private key (without 0x prefix)
PRIVATE_KEY=

# Optional: Base Sepolia RPC URL (default: https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Spending cap per session (default: 0.1 ETH)
SPENDING_LIMIT=0.1

# Optional: Contract address overrides (defaults are V5 deployments)
# COVENANT_IDENTITY_ADDRESS=
# COVENANT_ESCROW_ADDRESS=
# COVENANT_SETTLEMENT_ADDRESS=
# COVENANT_ARBITRATION_ADDRESS=
# COVENANT_ATTESTATION_ADDRESS=
# COVENANT_GOVERNANCE_ADDRESS=
# BATCH_ADDRESS=
# COLLECTIVE_ADDRESS=
# INSURANCE_ADDRESS=
# REVISION_ADDRESS=
# MARKET_ADDRESS=
# DISPUTE_ARBITRATION_ADDRESS=
# AGENT_INSURANCE_ADDRESS=
# TASK_ESCROW_ADDRESS=
# RECEIPT_VERIFIER_ADDRESS=
# AGENT_REGISTRY_ADDRESS=
