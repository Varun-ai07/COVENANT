# COVENANT CLI Configuration
# Copy to .env and fill in values

# Private key for signing transactions (with or without 0x prefix)
PRIVATE_KEY=

# RPC URL (defaults to Base Sepolia public RPC)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Override contract addresses (optional — defaults to deployed Base Sepolia addresses)
# REGISTRY_ADDRESS=0xB215589dA259A98eEE8BF39739F6255131ac33A1
# ESCROW_ADDRESS=0xFD081B5cB8bAE37DC878078bE3165932b0bC0BB3
# MARKET_ADDRESS=0x5ccF09469222E5046b0830c6d71ed6B912bE70e6
