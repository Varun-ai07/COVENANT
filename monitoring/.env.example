# COVENANT Monitoring Configuration

# Base Sepolia RPC endpoint
RPC_URL=https://sepolia.base.org

# The Graph Studio subgraph endpoint for querying indexed data
SUBGRAPH_URL=https://api.studio.thegraph.com/query/covenant/covenant-v2/version/v0.0.1

# Webhook URL for alert notifications (Slack, Discord, etc.)
ALERT_WEBHOOK_URL=

# Chain ID (84532 = Base Sepolia, 8453 = Base Mainnet)
CHAIN_ID=84532
