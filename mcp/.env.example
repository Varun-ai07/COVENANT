# COVENANT MCP Server Configuration

# === Network ===
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Use http://127.0.0.1:8545 for local Hardhat node

# === Contract Version ===
# "v1" (default) uses deployed Base Sepolia contracts
# "v2" uses new v2 contracts (set addresses below)
CONTRACT_VERSION=v1

# === Contract Addresses (Base Sepolia) ===
# Deploy contracts and fill in addresses, or leave blank for config.ts defaults
# Core Protocol
REGISTRY_ADDRESS=
ESCROW_ADDRESS=
VERIFIER_ADDRESS=
# Market & Batching
MARKET_ADDRESS=
BATCH_ADDRESS=
# Collective & Insurance
COLLECTIVE_ADDRESS=
INSURANCE_ADDRESS=
# Dispute Resolution
DISPUTE_ADDRESS=
# ZK Verifiers
CAPABILITY_VERIFIER_ADDRESS=
CAPABILITY_WRAPPER_ADDRESS=
REPUTATION_VERIFIER_ADDRESS=
REPUTATION_WRAPPER_ADDRESS=
# Router & Integration
ROUTER_ADDRESS=
LIT_ADDRESS=
# Wallet
WALLET_ADDRESS=

# === V2 Contract Addresses (fill after deployment) ===
# Used when CONTRACT_VERSION=v2
AGENT_REGISTRY_V2=0x0000000000000000000000000000000000000000
TASK_ESCROW_V2=0x0000000000000000000000000000000000000000
RECEIPT_VERIFIER_V2=0x0000000000000000000000000000000000000000
INSURANCE_POOL=0x0000000000000000000000000000000000000000
DISPUTE_RESOLUTION=0x0000000000000000000000000000000000000000

# === Wallet Mode ===
# autonomous: Server holds private key, signs and sends txs immediately
# prepare-only: Returns unsigned calldata for external signing
COVENANT_WALLET_MODE=autonomous

# === Private Key (only needed for autonomous mode) ===
# Leave empty for read-only mode (public client only)
PRIVATE_KEY=

# === HTTP Transport (only for --http mode) ===
MCP_HTTP_PORT=3001

# === API Key (required for HTTP transport) ===
MCP_API_KEY=
